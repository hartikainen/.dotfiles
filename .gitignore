.atom-build.json
*/enabled/*
.DS_Store
custom/*
!custom/example.bash
.rvmrc
aliases/custom.aliases.bash
completion/custom.completion.bash
lib/custom.bash
plugins/custom.plugins.bash
*.swp
.*.un~
bats
.idea
*.sublime-workspace
*.sublime-project
enabled/*
/enabled
tmp/

# Per-tool entries under `.config/` are no longer needed: `~/.config/<tool>/`
# is a real directory you own, and only files we explicitly track in this
# repo are symlinked into it. Runtime/local files (e.g. `~/.config/zsh/local`,
# `~/.config/zsh/.zcompdump*`, `~/.config/git/config.local`) live in your
# home dir and never appear inside this repo.
