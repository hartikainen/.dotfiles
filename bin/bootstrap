#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
upgrade=0
if [ "$#" = 1 ] && [ "${1:-}" = --upgrade-nix ]; then
    upgrade=1
elif [ "$#" != 0 ]; then
    echo 'Usage: bin/bootstrap [--upgrade-nix]' >&2
    exit 1
fi
case "$(uname -s)" in
    Linux)
        . /etc/os-release
        case "$ID" in ubuntu | debian) ;; *)
            echo 'Bootstrap supports Ubuntu and Debian.' >&2
            exit 1
            ;;
        esac
        sudo apt-get update
        sudo env DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=300 install -y ca-certificates curl xz-utils git python3
        ;;
    Darwin)
        if ! xcode-select -p >/dev/null 2>&1; then
            (
                marker=/tmp/.com.apple.dt.CommandLineTools.installondemand.in-progress
                if [ ! -e "$marker" ]; then
                    sudo touch "$marker"
                    trap 'sudo rm -f "$marker"' EXIT
                fi
                label="$(/usr/sbin/softwareupdate --list | sed -n 's/^[[:space:]]*\*[[:space:]]*Label: \(Command Line Tools.*\)/\1/p' | tail -n 1)"
                if [ -z "$label" ]; then
                    echo 'Apple did not offer Command Line Tools; complete xcode-select --install and rerun.' >&2
                    exit 1
                fi
                sudo /usr/sbin/softwareupdate --install "$label"
                sudo /usr/bin/xcode-select --switch /Library/Developer/CommandLineTools
            )
        fi
        ;;
    *)
        echo 'Unsupported operating system.' >&2
        exit 1
        ;;
esac

if ! command -v nix >/dev/null 2>&1 && [ ! -x /nix/var/nix/profiles/default/bin/nix ]; then
    installer="$(mktemp)"
    trap 'rm -f "$installer"' EXIT
    curl --fail --location --proto '=https' --tlsv1.2 \
        https://releases.nixos.org/nix/nix-2.34.4/install -o "$installer"
    python3 - "$installer" "$root/nix/bootstrap.json" <<'PY'
import hashlib, json, pathlib, sys
expected = json.loads(pathlib.Path(sys.argv[2]).read_text())["installerSha256"]
actual = hashlib.sha256(pathlib.Path(sys.argv[1]).read_bytes()).hexdigest()
if actual != expected:
    raise SystemExit("Nix installer checksum mismatch")
PY
    sh "$installer" --daemon --yes --no-channel-add
fi

if [ -f /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]; then
    # shellcheck disable=SC1091
    . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
fi
if ! nix --version | python3 -c 'import re,sys; v=re.search(r"(\d+)\.(\d+)",sys.stdin.read()); sys.exit(not v or tuple(map(int,v.groups())) < (2,32))'; then
    upgrade=1
fi
if [ "$upgrade" = 1 ]; then
    if [ "$(uname -s)" = Darwin ] && [ -e /nix/var/nix/profiles/system ]; then
        echo 'nix-darwin owns this Nix daemon; update and apply the macOS host configuration.' >&2
        exit 1
    fi
    case "$(nix --version)" in
        'nix (Nix) '*) ;;
        *)
            echo 'Upgrade this Nix distribution with its owning installer.' >&2
            exit 1
            ;;
    esac
    if [ ! -e /nix/var/nix/profiles/default/bin/nix ]; then
        echo 'Upgrade this Nix installation with its owning installer to Nix >= 2.32.' >&2
        exit 1
    fi
    export DOTFILES_BOOTSTRAP_ROOT="$root"
    package="$(nix --extra-experimental-features 'nix-command flakes' build --impure --no-link --print-out-paths --expr '
      let flake = builtins.getFlake ("path:" + builtins.getEnv "DOTFILES_BOOTSTRAP_ROOT");
      in flake.inputs.nixpkgs.legacyPackages.${builtins.currentSystem}.nix
    ')"
    sudo "$(command -v nix-env)" --profile /nix/var/nix/profiles/default --install "$package"
    if [ "$(uname -s)" = Linux ]; then
        sudo systemctl restart nix-daemon.service
    else
        sudo launchctl kickstart -k system/org.nixos.nix-daemon
    fi
fi
