#!/usr/bin/env python3
import argparse
import json
import math
import os
from pathlib import Path
import subprocess
import sys
import tempfile


def convert(source, output, max_mb):
    source = source.expanduser().resolve(strict=True)
    output = output.expanduser().absolute()
    if output.exists() or output.is_symlink():
        raise ValueError(f"Output already exists: {output}")
    if output.suffix.lower() != ".mp4":
        raise ValueError("Output must have an .mp4 extension")
    probe = json.loads(
        subprocess.check_output(
            [
                "ffprobe",
                "-v",
                "error",
                "-select_streams",
                "V:0",
                "-show_streams",
                "-show_format",
                "-of",
                "json",
                str(source),
            ],
            text=True,
        )
    )
    if not probe["streams"]:
        raise ValueError("Input has no video stream")
    duration = float(probe["format"].get("duration", 0))
    if not math.isfinite(duration) or duration <= 0:
        raise ValueError("Input must have a finite, positive duration")
    limit = int(max_mb * 1_000_000)
    # Reserve space for AAC audio, MP4 overhead, and rate-control variation.
    rate = min(1250, int(limit * 8 * 0.94 / duration / 1000) - 96)
    if rate < 150:
        raise ValueError("Video is too long for this size budget; increase --max-mb")
    hdr = probe["streams"][0].get("color_transfer") in {"arib-std-b67", "smpte2084"}
    filters = [
        "fps='min(source_fps,30)'",
        "scale=w='min(iw,if(gte(iw,ih),1280,720))':"
        "h='min(ih,if(gte(iw,ih),720,1280))':"
        "force_original_aspect_ratio=decrease:force_divisible_by=2:reset_sar=1",
    ]
    if hdr:
        filters += [
            "zscale=t=linear:npl=100",
            "format=gbrpf32le",
            "zscale=p=bt709",
            "tonemap=hable:desat=0",
            "zscale=t=bt709:m=bt709:r=tv",
        ]
    filters.append("format=yuv420p")
    print(
        f"{'HDR → SDR' if hdr else 'SDR'}; video ceiling {rate} kb/s", file=sys.stderr
    )
    with tempfile.TemporaryDirectory(prefix=".video-share-", dir=output.parent) as temp:
        candidate = Path(temp) / "output.mp4"
        command = [
            "ffmpeg",
            "-hide_banner",
            "-loglevel",
            "warning",
            "-stats",
            "-nostdin",
            "-n",
            "-i",
            str(source),
            "-map",
            "0:V:0",
            "-map",
            "0:a:0?",
            "-map_metadata",
            "-1",
            "-map_metadata:s",
            "-1",
            "-map_chapters",
            "-1",
            "-vf",
            ",".join(filters),
            "-c:v",
            "libx264",
            "-preset",
            "medium",
            "-crf",
            "24",
            "-maxrate",
            f"{rate}k",
            "-bufsize",
            f"{rate * 2}k",
            "-pix_fmt",
            "yuv420p",
            "-c:a",
            "aac",
            "-b:a",
            "96k",
            "-ac",
            "2",
            "-movflags",
            "+faststart",
        ]
        if hdr:
            command += [
                "-color_primaries",
                "bt709",
                "-color_trc",
                "bt709",
                "-colorspace",
                "bt709",
                "-color_range",
                "tv",
            ]
        subprocess.run(command + [str(candidate)], check=True)
        size = candidate.stat().st_size
        if size > limit:
            raise ValueError(
                f"Encoded video exceeds {max_mb:g} MB; increase --max-mb "
                "or shorten the input"
            )
        subprocess.run(
            [
                "ffmpeg",
                "-v",
                "error",
                "-xerror",
                "-nostdin",
                "-i",
                str(candidate),
                "-map",
                "0:v:0",
                "-map",
                "0:a:0?",
                "-f",
                "null",
                "-",
            ],
            check=True,
        )
        # Publish only a complete, decoded file, without replacing an existing path.
        os.link(candidate, output)
    print(f"{output} ({size / 1_000_000:.2f} MB)")


def main():
    parser = argparse.ArgumentParser(
        description="Convert a video to a small H.264/AAC MP4 for sharing.",
        epilog="Detects HLG/PQ HDR, preserves orientation, and removes source metadata. "
        "Requires ffmpeg (libx264, zscale, tonemap) and ffprobe. Existing files are never replaced.",
    )
    parser.add_argument("input", type=Path)
    parser.add_argument("output", type=Path, nargs="?", help="default: INPUT-share.mp4")
    parser.add_argument(
        "--max-mb",
        type=float,
        default=9.5,
        help="size budget in decimal MB (default: 9.5)",
    )
    args = parser.parse_args()
    if not math.isfinite(args.max_mb) or args.max_mb <= 0:
        parser.error("--max-mb must be finite and positive")
    output = args.output or args.input.with_name(args.input.stem + "-share.mp4")
    try:
        convert(args.input, output, args.max_mb)
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        parser.exit(1, f"video-share: {error}\n")
    except KeyboardInterrupt:
        parser.exit(130, "video-share: interrupted\n")


if __name__ == "__main__":
    main()
