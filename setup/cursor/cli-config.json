{
  "approvalMode": "allowlist",
  "attribution": {
    "attributeCommitsToAgent": false,
    "attributePRsToAgent": false
  },
  "autoAcceptWebSearch": false,
  "display": {
    "mode": "zen",
    "showLineNumbers": true,
    "showStatusIndicators": true,
    "showStatusLineRunningTime": true,
    "showThinkingBlocks": false
  },
  "editor": {
    "vimMode": false
  },
  "exploreSubagentModel": "default",
  "hints": true,
  "modelSlashCommands": true,
  "network": {
    "useHttp1ForAgent": false
  },
  "notifications": true,
  "permissions": {
    "allow": [
      "Shell(.venv/bin/ruff)",
      "Shell(bazel info)",
      "Shell(bazel query)",
      "Shell(bazel mod)",
      "Shell(bazel run //:buildifier.fix)",
      "Shell(bazel run //:gazelle)",
      "Shell(bazel run //tools/format)",
      "Shell(cat)",
      "Shell(cd)",
      "Shell(diff)",
      "Shell(echo)",
      "Shell(find)",
      "Shell(gh pr checks)",
      "Shell(gh pr diff)",
      "Shell(gh pr status)",
      "Shell(gh pr view)",
      "Shell(gh issue view)",
      "Shell(git add)",
      "Shell(git branch -a)",
      "Shell(git branch --show-current)",
      "Shell(git cat-file)",
      "Shell(git check-ignore)",
      "Shell(git diff)",
      "Shell(git fetch)",
      "Shell(git grep)",
      "Shell(git log)",
      "Shell(git ls-files)",
      "Shell(git ls-tree)",
      "Shell(git remote -v)",
      "Shell(git rev-parse)",
      "Shell(git show)",
      "Shell(git status)",
      "Shell(git worktree add)",
      "Shell(git worktree list)",
      "Shell(grep)",
      "Shell(head)",
      "Shell(ls)",
      "Shell(read)",
      "Shell(rg)",
      "Shell(ruff)",
      "Shell(sed)",
      "Shell(sort)",
      "Shell(stat)",
      "Shell(tail)",
      "Shell(true)",
      "Shell(ty)",
      "Shell(wc)",
      "Shell(git blame)",
      "WebFetch(jobs.ashbyhq.com)",
      "WebFetch(raw.githubusercontent.com)",
      "Shell(command)"
    ],
    "deny": [
      "Shell(chmod 777 **)",
      "Shell(gh api **event=APPROVE**)",
      "Shell(gh api **event=COMMENT**)",
      "Shell(gh api **event=REQUEST_CHANGES**)",
      "Shell(gh api **submitPullRequestReview**)",
      "Shell(gh issue comment**)",
      "Shell(gh issue create**)",
      "Shell(gh issue edit**)",
      "Shell(gh pr close**)",
      "Shell(gh pr comment**)",
      "Shell(gh pr create**)",
      "Shell(gh pr edit**)",
      "Shell(gh pr merge**)",
      "Shell(gh pr review**)",
      "Shell(gh release create**)",
      "Shell(git checkout -- **)",
      "Shell(git clean **)",
      "Shell(git push **)",
      "Shell(git reset --hard**)",
      "Shell(git restore **)",
      "Shell(rm -rf **)",
      "Shell(sudo **)"
    ]
  },
  "rewind": true,
  "sandbox": {
    "mode": "disabled",
    "networkAccess": "user_config_with_defaults"
  }
}
