.atom-build.json
*/enabled/*
.DS_Store
custom/*
!custom/example.bash
.rvmrc
aliases/custom.aliases.bash
completion/custom.completion.bash
lib/custom.bash
plugins/custom.plugins.bash
*.swp
.*.un~
bats
.idea
*.sublime-workspace
*.sublime-project
enabled/*
/enabled
tmp/

# `~/.config/<tool>/` is a real directory you own, and only files tracked here
# are symlinked into it, so runtime and local files belong under `$HOME` rather
# than in this checkout. Tools that wrote through the legacy whole-directory
# `~/.config` symlink left their state behind here when
# `migrate_config_symlink` replaced it, and this repository is public, so the
# entries below keep the credential-bearing ones out of history if they
# reappear. Each names a file rather than its directory, leaving room to track
# real configuration alongside it.
.config/bash/local
.config/emacs/
.config/fzf/fzf.bash
.config/fzf/fzf.zsh
.config/gcloud/
.config/gh/config.yml
.config/gh/hosts.yml
.config/github-copilot/
.config/mlflow/telemetry.json
.config/packer/
.config/zsh/.zsh_sessions/
.config/zsh/local

# A credential store carries the same risk from any tool, tracked or not.
**/access_tokens.db
**/application_default_credentials.json
**/credentials.db
